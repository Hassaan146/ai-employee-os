# Backend service (FastAPI) — backend/app/main.py
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# AI service (FastAPI) — ai/app/main.py
NEXT_PUBLIC_AI_URL=http://localhost:8001

# When "true", pages fall back to local preview fixtures for any endpoint
# the backend has not implemented yet. Set to "false" once the real
# REST endpoints land so missing data surfaces as an error instead.
NEXT_PUBLIC_ALLOW_PREVIEW_DATA=true
